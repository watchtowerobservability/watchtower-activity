{
  "name": "@watchtowerobservability/activity",
  "version": "0.1.0",
  "description": "Watchtower hosted activity log: server SDK (record events, mint viewer sessions, list, export)",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "esbuild": "0.28.2",
    "typescript": "5.7.2",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watchtowerobservability/watchtower-activity.git"
  },
  "homepage": "https://github.com/watchtowerobservability/watchtower-activity#readme"
}
